Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: false
      Cell Size: 1
      Color: 160; 160; 164
      Name: Grid
      Plane: XY
      Reference Frame: map
      Value: false
    - Class: rviz/Map
      Enabled: true
      Name: House map
      Topic: /map
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz/Map
      Enabled: true
      Name: Coverage
      Topic: /coverage_grid
      Alpha: 0.75
      Color Scheme: costmap
      Draw Behind: false
      Value: true
    - Class: rviz/LaserScan
      Enabled: true
      Name: Scan
      Topic: /scan
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Size (m): 0.03
      Style: Points
      Value: true
    - Class: rviz/PoseArray
      Enabled: true
      Name: AMCL particles
      Topic: /particlecloud
      Color: 90; 200; 255
      Arrow Length: 0.1
      Value: true
    - Class: rviz/TF
      Enabled: false
      Name: TF
      Marker Scale: 0.4
      Show Names: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      X: 0
      Y: 0
      Scale: 95
      Angle: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
